def round_decimal(input: str, scale: int) -> str: ...
def divide_decimal(numerator: str, denominator: str, scale: int) -> str: ...
def legal_quantity(quantity: int, numerator: str, denominator: str, step: int) -> int: ...
def roundtrip_ns(input: str) -> str: ...
def validate_market_event_json(input: str) -> str: ...
def validate_commission_config_json(input: str, overrides: str = "{}") -> str: ...
def compose_official_fee_config_json(input: str) -> str: ...
def official_market_rules_json() -> str: ...
def validate_formal_calendar_json(input: str) -> str: ...
def indicator_json(input: str) -> str: ...
MAX_VIEW_ROWS: int
MAX_VIEW_BYTES: int

class ReadView:
    def __init__(self, boundary: str, max_rows: int = 10000, max_bytes: int = 67108864) -> None: ...
    def check(self) -> None: ...
    def visible_key_json(self, key: str) -> bool: ...
    def reset(self) -> None: ...
    def resources_json(self) -> str: ...
    def expire(self) -> None: ...
    def push_market(self, metadata: str, payload: bytes) -> None: ...
    def push_research(self, metadata: str, payload: bytes) -> None: ...
    def prices_json(self, request: str, source_frequency: str, calendar: str = '[]') -> str: ...
    def research_json(self, request: str) -> str: ...
    def research_prices(self, request: str) -> None: ...
    def current_json(self, securities: str) -> str: ...

class CancellationToken:
    def __init__(self) -> None: ...
    def cancel(self) -> None: ...
    @property
    def cancelled(self) -> bool: ...

class CallbackBridge:
    def check(self) -> None: ...
    def request(self, operation: str, input: str) -> tuple[str, bytes]: ...

class RunResult:
    def summary_json(self) -> str: ...
    def metadata_page_json(self, after: str | None = None, limit: int = 1000) -> str: ...
    def page_json(self, kind: str, after: str | None = None, limit: int = 1000) -> str: ...
    def close(self) -> None: ...

from typing import Callable
def run_strategy(input: str, handlers: str, dispatch: Callable[[str, str, CallbackBridge], None], cancellation: CancellationToken, calendar_input: str | None = None, progress_callback: Callable[[str], object] | None = None) -> RunResult: ...
def strategy_error_json(error: BaseException) -> str: ...

# Internal trusted D12 transfer; not user strategy or REST file-path APIs.
class TrustedResultWriter:
    @staticmethod
    def validate_outcome_json(input: str) -> str: ...
    def __init__(self, parent: str, run_id: str, maximum: int) -> None: ...
    def write_json(self, input: str) -> None: ...
    def notices_json(self, input: str) -> None: ...
    def seal(self, input: str) -> None: ...
    def retain(self) -> str: ...
    def directory_name(self) -> str: ...
    def overview_json(self) -> str: ...

class RetainedResultReader:
    def __init__(self, parent: str, directory_name: str, run_id: str) -> None: ...
    def summary_json(self) -> str: ...
    def page_json(self, kind: str, after: str | None = None, limit: int = 100) -> str: ...
