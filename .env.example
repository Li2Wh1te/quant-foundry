# 应用显示名称，用于 OpenAPI 文档标题。
QF_APP_NAME=Quant Foundry API

# 运行环境，可选值：local、test、production。
QF_ENVIRONMENT=local

# 是否开启调试模式；生产环境必须设置为 false。
QF_DEBUG=false

# 服务监听 IP；本地开发使用 127.0.0.1，对外提供服务可使用 0.0.0.0。
QF_SERVER_HOST=127.0.0.1

# 服务监听端口，可选范围为 1-65535。
QF_SERVER_PORT=8000

# API Bearer Token；首次执行 make selfhost 时自动生成，请勿提交真实 Token。
QF_API_TOKEN=

# 本地结构化日志目录；相对路径以项目根目录为基准。
QF_LOG_DIR=data/logs

# 最低日志级别，可选值：DEBUG、INFO、WARNING、ERROR、CRITICAL。
QF_LOG_LEVEL=INFO

# 按天轮转后保留的历史日志天数。
QF_LOG_RETENTION_DAYS=30

# 异步日志队列容量；队列满时低级别日志直接丢弃，警告及以上最多等待 50ms。
QF_LOG_QUEUE_SIZE=10000

# 单次查询最多扫描的当前及历史日志文件数量。
QF_LOG_QUERY_MAX_FILES=32

# PostgreSQL 地址和端口。
QF_DATABASE_HOST=127.0.0.1
QF_DATABASE_PORT=5432

# PostgreSQL 用户和数据库名称。
QF_DATABASE_USER=postgres
QF_DATABASE_NAME=quant_foundry

# 首次执行 make selfhost 时自动生成，请勿提交真实密码。
QF_DATABASE_PASSWORD=
