# 应用显示名称，用于 OpenAPI 文档标题。
QF_APP_NAME=Quant Foundry API

# 运行环境，可选值：local、test、production。
QF_ENVIRONMENT=local

# 是否开启调试模式；生产环境必须设置为 false。
QF_DEBUG=false

# 服务监听 IP；容器部署必须使用 0.0.0.0，源码本地运行可改为 127.0.0.1。
QF_SERVER_HOST=0.0.0.0

# 服务监听端口，可选范围为 1-65535。
QF_SERVER_PORT=8000

# API Bearer Token；首次执行 make selfhost 时自动生成，请勿提交真实 Token。
QF_API_TOKEN=

# 游标签名密钥；仅服务端持有，用于回测结果游标的 HMAC 签名，不得下发给客户端。首次执行 make selfhost 时自动生成。
QF_CURSOR_SIGNING_KEY=

# 本地结构化日志目录；相对路径以项目根目录为基准。
QF_LOG_DIR=data/logs

# 最低日志级别，可选值：DEBUG、INFO、WARNING、ERROR、CRITICAL。
QF_LOG_LEVEL=INFO

# 按天轮转后保留的历史日志天数。
QF_LOG_RETENTION_DAYS=30

# 异步日志队列容量；队列满时低级别日志直接丢弃，警告及以上最多等待 50ms。
QF_LOG_QUEUE_SIZE=10000

# 单次查询最多扫描的当前及历史日志文件数量。
QF_LOG_QUERY_MAX_FILES=32

# Enable the in-process scheduler and configure its persistent run dispatcher.
QF_SCHEDULER_ENABLED=true
QF_SCHEDULER_MAX_WORKERS=4
QF_SCHEDULER_DISPATCH_INTERVAL_MS=500
QF_SCHEDULER_MAX_QUEUED_RUNS=1000
QF_SCHEDULER_MISFIRE_GRACE_SECONDS=60

# Backtest execution is isolated from the ingestion scheduler. The internal
# acceptance queue remains disabled until an explicit limit below is set.
QF_BACKTEST_MAX_WORKERS=1
QF_BACKTEST_FORMAL_QUEUE_LIMIT=32
# QF_BACKTEST_INTERNAL_QUEUE_LIMIT=8

# Tushare Pro Token；仅在使用 Tushare 数据源时填写，请勿提交真实 Token。
QF_TUSHARE_TOKEN=

# Tushare SDK 请求地址；如使用代理地址，请填写完整的 HTTP(S) 地址。
QF_TUSHARE_API_URL=http://api.tushare.pro

# 外部数据源请求开始时间之间的最小间隔（毫秒）；任务参数只能提高此值。
QF_INGESTION_REQUEST_INTERVAL_MS=1000

# PostgreSQL 地址和端口。
QF_DATABASE_HOST=127.0.0.1
QF_DATABASE_PORT=5432

# PostgreSQL 用户和数据库名称。
QF_DATABASE_USER=postgres
QF_DATABASE_NAME=quant_foundry

# 首次执行 make selfhost 时自动生成，请勿提交真实密码。
QF_DATABASE_PASSWORD=
